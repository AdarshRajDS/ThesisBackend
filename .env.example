# --- LLM (local only — LM Studio) ---
# Online/cloud LLMs are disabled unless LLM_ALLOW_ONLINE=true (not for thesis submission).
LLM_PROVIDER=lmstudio
LLM_ALLOW_ONLINE=false
LLM_API_BASE=http://127.0.0.1:1234/v1
LLM_API_KEY=lm-studio
# Must match the model id shown in LM Studio (Developer → Local Server).
LLM_MODEL=google/gemma-4-e2b

# Data directory (default: data). Use a persistent path in production (e.g. /data on Hugging Face).
HF_HOME=data

# Base URL for local /outputs image links when object storage is not used
# Must match the port where uvicorn runs (e.g. 8000). Wrong values break anatomy viewer/GLB URLs.
PUBLIC_BASE_URL=http://127.0.0.1:8000
PUBLIC_API_BASE=http://127.0.0.1:8000

# --- Object storage ---
# Use "minio" or "supabase". If unset, the app uses Supabase when SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are both set; otherwise MinIO.
STORAGE_PROVIDER=minio

# --- MinIO (when STORAGE_PROVIDER=minio) ---
MINIO_ENABLED=true
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=anatomy-images
MINIO_SECURE=false

# --- Supabase Storage (when STORAGE_PROVIDER=supabase) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_BUCKET=anatomy-images
SUPABASE_SIGNED_URL_EXPIRE=3600

# --- Anatomy MCP / Blender ---
ANATOMY_MCP_ENABLED=true
BLENDER_BIN=C:\Program Files\Blender Foundation\Blender 5.1\blender.exe
Z_ANATOMY_BLEND=C:\Path\To\Z-Anatomy\Startup.blend
BLENDER_SERVER_URL=http://127.0.0.1:8001

# --- CORS (comma-separated) ---
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- MinIO license (Enterprise/SUBNET only) ---
# MINIO_LICENSE_FILE=./minio.license
